{
  "name": "classify",
  "version": "1.0.0",
  "description": "Classify — Class Assignment Optimizer",
  "author": "Classify",
  "repository": {
    "type": "git",
    "url": "https://github.com/shobel/class-assigner.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win"
  },
  "build": {
    "appId": "com.classify.app",
    "productName": "Classify",
    "copyright": "Copyright © 2025",
    "publish": {
      "provider": "github",
      "owner": "shobel",
      "repo": "class-assigner"
    },
    "directories": {
      "output": "../dist"
    },
    "extraResources": [
      {
        "from": "../dist/classify-server",
        "to": "server",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Classify-Setup-${version}.${ext}",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
